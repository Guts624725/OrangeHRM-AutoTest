# ==============================================
# 自动化测试框架 全局配置文件（模板）
# 使用说明：
#   1. 复制本文件为 配置文件.ini
#   2. 将所有 ${...} 替换为真实值
#   3. 配置文件.ini 已加入 .gitignore，不会提交到仓库
# ==============================================

[客户端自动化配置]
# 鼠标移动速度（秒）
duration = 0.2
# 点击间隔时间（秒），0为立即执行
interval = 0.25
# 图片识别隐式等待最大时间（秒）
minSearchTime = 5
# 图片识别信任度（0-1）
confidence = 0.97
# 是否开启灰度匹配（True/False）
grayscale = True

[web自动化配置]
# 浏览器类型：chrome / firefox / edge / ie / chromeheadless
browser = chrome

[日志打印配置]
# 日志输出格式
formatter = %(asctime)s - %(name)s - %(levelname)s - %(message)s
# 全局日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
level = INFO
# 控制台输出级别
stream_handler_level = DEBUG
# 文件输出级别
file_handler_level = DEBUG

[邮件发送配置]
# SMTP服务器地址，示例：smtp.qq.com / smtp.163.com / smtp.gmail.com
host = ${SMTP_HOST}
# SMTP端口(SSL)，示例：465(QQ/163) / 587(Gmail)
port = ${SMTP_PORT}
# 发件人邮箱，示例：xxxxxx@qq.com
send_email = ${SENDER_EMAIL}
# 收件人邮箱列表，示例：["aaa@qq.com", "bbb@qq.com"]
receiver = ${RECEIVER_EMAIL_LIST}
# 邮箱授权码（非登录密码），示例：jesvhkpsmtefcajj
pwd = ${EMAIL_AUTH_CODE}
# 发件人显示昵称
sender = ${SENDER_NAME}
# 邮件标题
subject = 自动化测试报告

[数据库连接配置]
# 数据库类型：mysql / mariadb / postgresql
dbtype = mysql
# 数据库地址，本地填 127.0.0.1，Docker/Jenkins 环境填宿主机 IP 或 host.docker.internal
host = ${DB_HOST}
# 数据库用户名
user = ${DB_USER}
# 数据库密码
passwd = ${DB_PASSWORD}
# 数据库端口，MySQL 默认 3306
port = ${DB_PORT}
# 数据库名
database = orangehrm

[项目运行配置]
# 自动化类型：HTTP(接口) / WEB / CLIENT(客户端)
AUTO_TYPE = HTTP
# 报告类型：ALLURE / HTML / XML
REPORT_TYPE = ALLURE
# 数据驱动类型：YamlDriver / ExcelDriver
DATA_DRIVER_TYPE = YamlDriver
# 测试项目名，对应 Data/TestSuits 目录名，示例：ohrm_http_test
TEST_PROJECT = ohrm_http_test
# 测试环境地址，末尾必须带斜杠 /，示例：http://192.168.1.3:8080/
TEST_URL = ${TEST_URL}
# 执行完成是否发送邮件：yes / no
IS_EMAIL = yes

[login]
# 登录用户名
username = ${LOGIN_USERNAME}
# 登录密码
password = ${LOGIN_PASSWORD}